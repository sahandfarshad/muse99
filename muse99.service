[Unit]
Description=Muse99 — personal agent (web UI + SSH menu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/muse99
Environment=MODEL_API_KEY=your-key-here
Environment=MODEL_API_BASE_URL=https://api.meta.ai/v1
Environment=MODEL_ID=muse-spark-1.3
Environment=MUSE_USER_NAME=Takahashi
# Web UI on :8080, SSH menu is not used in service mode — use --menu=false --web
ExecStart=%h/.local/bin/muse99 --menu=false --web --port 8080 --allow-shell
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
